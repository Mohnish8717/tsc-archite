{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_HUGGINGFACE_SPACE_URL.hf.space/api/$1"
    },
    {
      "source": "/ws/(.*)",
      "destination": "https://YOUR_HUGGINGFACE_SPACE_URL.hf.space/ws/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
